; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="waribikigame"
run/main_scene="uid://oows4t73rmft"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SceneManager="*res://addons/scene_manager/SceneManager.tscn"
SceneStorage="*res://SceneStorage.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/scene_manager/plugin.cfg", "res://addons/timer_ui/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gui]

theme/custom_font="uid://dx34p7d5owvl7"
theme/default_font_antialiasing=0
theme/default_font_hinting=0

